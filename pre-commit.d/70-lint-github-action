#!/usr/bin/env sh
set -ue

if [ "$VERBOSITY" -ge 7 ]
then
    shopt=x
    show_progress=1
else
    shopt=
    show_progress=
fi

if [ -n "$AGAINST" ]
then
    actionlint_bin=
    if actionlint --help 2>&1 | grep -q 'linter for GitHub Actions workflow files'
    then
        actionlint_bin="actionlint"
    elif gh actionlint --help >/dev/null 2>&1
    then
        actionlint_bin="gh actionlint"
    fi

    if [ -n "$actionlint_bin" ]
    then
        # actionlint does not look for its config when reading from stdin
        config_opt=
        for config_file in .github/actionlint.yaml .github/actionlint.yml
        do
            if [ -f "$config_file" ]
            then
                config_opt="-config-file $config_file"
                break
            fi
        done

        set -- '.github/workflows/*.yml' '.github/workflows/*.yaml'

        # Don’t use --cached when AGAINST is a range (i.e. we are running pre-push hook)
        # TODO Duplicated for all lint-* pre-commit hooks
        if echo "$AGAINST" | grep -q -F ".."
        then
            diff_opt=
        else
            diff_opt="--cached"
        fi

        total=$(( $(
            git diff $diff_opt --diff-filter=ACMR --name-only "$AGAINST" -- "$@" \
                | wc -l
        ) ))
        if [ "$total" -gt 0 ]
        then
            git diff $diff_opt --diff-filter=ACMR --name-only "$AGAINST" -- "$@" |
                nl |
                while read -r number file
                do
                    if [ -n "$show_progress" ] && [ "$total" != "1" ]
                    then
                        printf "%d/%d: " "$number" "$total" 1>&2
                    fi
                    git show ":$file" | {
                        set -"$shopt"
                        $actionlint_bin $config_opt -
                    }
                done
        fi
    fi
fi
